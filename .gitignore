# ==========================================
# Dependencies
# ==========================================
node_modules/
.pnp
.pnp.js

# ==========================================
# Environment Variables & Secret Files
# ==========================================
# Ignore all .env files anywhere in the repo
.env
.env.*
*.env
**/.env
**/.env.*
!**/.env.example
!**/.env*.example

# Cloudflare Wrangler Local Secrets
.dev.vars
.dev.vars.*
**/.dev.vars
**/.dev.vars.*
!**/.dev.vars.example

# Private Keys, Certificates & Credentials
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
*credentials*.json
*secret*.json
service-account*.json
id_rsa
id_ed25519

# ==========================================
# Storage & Uploads Local Cache
# ==========================================
storage/uploads/*
!storage/uploads/.gitkeep

# ==========================================
# Temporary Files & Scratch Space
# ==========================================
scratch/
tmp/
temp/
*.tmp

# ==========================================
# Build & Distribution Outputs
# ==========================================
dist/
build/
out/
.wrangler/
coverage/
.nyc_output/

# ==========================================
# System & Editor Files
# ==========================================
.DS_Store
Thumbs.db
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
