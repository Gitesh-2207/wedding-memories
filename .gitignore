# ==========================================
# Dependencies & Package Managers
# ==========================================
node_modules/
**/node_modules/
.pnp
.pnp.js

# Package lock files
package-lock.json
**/package-lock.json
yarn.lock
**/yarn.lock
pnpm-lock.yaml
**/pnpm-lock.yaml
bun.lockb
**/bun.lockb

# ==========================================
# JSON Files, Data & Credentials
# ==========================================
# Ignore data/credential JSON files across workspace
*.json
**/*.json
# Explicitly keep essential project manifests and configurations:
!package.json
!**/package.json
!vercel.json
!**/vercel.json
!tsconfig*.json
!**/tsconfig*.json

# ==========================================
# Environment Variables & Secret Files
# ==========================================
# Ignore all .env files anywhere in the repo
.env
.env.*
*.env
**/.env
**/.env.*
!**/.env.example
!**/.env*.example

# Cloudflare Wrangler Local Secrets
.dev.vars
.dev.vars.*
**/.dev.vars
**/.dev.vars.*
!**/.dev.vars.example

# Private Keys, Certificates & Credentials
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
*credentials*.json
*secret*.json
service-account*.json
id_rsa
id_ed25519

# ==========================================
# Storage & Uploads Local Cache
# ==========================================
storage/uploads/*
!storage/uploads/.gitkeep

# ==========================================
# Temporary Files & Scratch Space
# ==========================================
scratch/
tmp/
temp/
*.tmp

# ==========================================
# Build & Distribution Outputs
# ==========================================
dist/
build/
out/
.wrangler/
coverage/
.nyc_output/

# ==========================================
# System & Editor Files
# ==========================================
.DS_Store
Thumbs.db
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
