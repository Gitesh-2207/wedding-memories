PORT=5000
NODE_ENV=production
FRONTEND_URL=https://royal-wedding-memories.pages.dev
JWT_SECRET=replace_with_a_64_character_cryptographically_secure_secret
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@cluster0.trjwobw.mongodb.net/wedding_memories?retryWrites=true&w=majority

# Cloud Storage: Cloudinary (Option A)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

# Cloud Storage: Cloudflare R2 (Option B)
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=royal-wedding-memories-bucket

CLOUDFLARE_TURNSTILE_SECRET_KEY=0x4AAAAAA...your_turnstile_secret
